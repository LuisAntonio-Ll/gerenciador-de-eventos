{
  "info": {
    "name": "Event Manager API - Testes",
    "description": "Rode com o Collection Runner (na ordem). Banco limpo não é necessário: cada execução cria um evento novo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Criar evento SEM capacity (deve dar 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Retorna detalhes do erro', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('details');",
              "  pm.expect(json.details.join(' ')).to.include('capacity');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Workshop Node\",\n  \"date\": \"2026-11-10T19:00:00Z\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
