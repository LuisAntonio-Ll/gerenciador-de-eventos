    {
      "name": "11. Listar eventos e conferir contagem",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const events = pm.response.json();",
              "pm.test('Resposta é uma lista', function () { pm.expect(events).to.be.an('array'); });",
              "pm.test('Evento criado tem 2 inscrições', function () {",
              "  const id = Number(pm.collectionVariables.get('eventId'));",
              "  const ev = events.find(e => e.id === id);",
              "  pm.expect(ev, 'evento encontrado').to.exist;",
              "  pm.expect(Number(ev.registrationsCount)).to.eql(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ]
        }
      }
