    {
      "name": "4. Criar evento válido (capacity 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('Evento criado com os dados corretos', function () {",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json.title).to.eql('Workshop Node');",
              "  pm.expect(json.capacity).to.eql(2);",
              "});",
              "pm.collectionVariables.set('eventId', json.id);"
            ]
          }
        }
      ],
